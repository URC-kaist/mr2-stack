# Optional overrides for compose/local/compose.local.yaml (export them, or put them
# in compose/local/.env). Nothing here is required.
MR2_VIDEO=false                 # true: stream the simulated camera
MR2_TILES=                      # folder with offline map tiles (naip/, ...)
BASE_XBEE_HEARTBEAT_HZ=2        # gateway heartbeat; 2 = field parity
