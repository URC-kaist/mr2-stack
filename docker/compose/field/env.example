# Copy to docker/compose/field/.env on each machine (untracked).
# Addresses on the field LAN (through the Rocket M2 radios).
MR2_BASE_IP=192.168.1.101
MR2_ROVER_IP=192.168.1.102
MR2_BASE_ROCKET_IP=192.168.1.100
MR2_DRONE_ROCKET_IP=192.168.1.103
MR2_ROVER_ROCKET_IP=192.168.1.106

# Different ROS domains on base and rover (corrections loop otherwise).
BASE_ROS_DOMAIN_ID=11
ROVER_ROS_DOMAIN_ID=10

# Base only: Rocket M2 status login, antenna tracker.
ROCKET_M2_ENABLE=true
ROCKET_M2_USER=
ROCKET_M2_PASS=
BASE_ANTENNA_ENABLE=true

# Offline map tiles on the base computer (map-pipeline output).
MR2_TILES=/var/www/mr2-tiles
