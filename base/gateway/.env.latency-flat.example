# Merge these settings into base/gateway/.env.local; do not overwrite its
# existing serial, antenna, network, or ROS relay settings.
# Resolve VIDEO_CONFIG_PATH to an absolute path in the deployed checkout.
VIDEO_CONFIG_PATH=/path/to/mr2-stack/rover/ros2_ws/src/mr2_launch/config/video_streams_flat.json
MR2_LATENCY_DIAGNOSTICS_ENABLE=true
# Replace with the base NIC connected to Rocket, from: ip route get <ROVER_IP>
MR2_BASE_ROCKET_INTERFACE=REPLACE_WITH_BASE_INTERFACE
# Rover-reachable HTTP nginx endpoint. No HTTPS redirect on /latency/uplink/.
MR2_LATENCY_PUBLIC_BASE_URL=http://REPLACE_WITH_BASE_IP
MR2_LATENCY_ARTIFACT_DIR=/tmp/mr2-latency-base
